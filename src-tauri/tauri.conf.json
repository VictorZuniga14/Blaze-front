{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blaze",
  "version": "0.1.0",
  "identifier": "com.blaze.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Blaze",
        "width": 1100,
        "height": 720,
        "decorations": false,
        "backgroundColor": [11, 15, 20]
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/pcsx2/**/*",
      "resources/retroarch/**/*",
      "resources/emulators/packs/**/*"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
