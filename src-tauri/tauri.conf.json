{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blaze",
  "version": "0.1.15",
  "identifier": "com.blaze.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "updater",
        "title": "Blaze",
        "width": 460,
        "height": 168,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "center": true,
        "decorations": true,
        "visible": true,
        "backgroundColor": [32, 36, 42]
      },
      {
        "label": "main",
        "title": "Blaze",
        "width": 1100,
        "height": 720,
        "decorations": false,
        "visible": false,
        "backgroundColor": [11, 15, 20]
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' http://localhost:* https://*; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["resources/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/pcsx2/.gitkeep",
      "resources/retroarch/.gitkeep",
      "resources/eden/.gitkeep"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDNTcyQUE5QzdCQUNBQzMKUldURHlyckhxU3BYRFBtbU9SejV0cDZad0hsYjRLUjQ1Rjc4TU9SMHl1SituQ01ZMGJ5VXQ2dmwK",
      "endpoints": [
        "https://github.com/VictorZuniga14/Blaze-front/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
